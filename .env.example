# --- Simplest setup: built-in password (run ./setup.sh to write this for you) ---------------------------------
# MYFLIX_AUTH=password                 # default is "cloudflare" (see below). "password" needs no Cloudflare account.
# MYFLIX_PASSWORD=choose-something-long  # or MYFLIX_PASSWORD_FILE=/run/secrets/myflix_password; min 8 characters
# In password mode JELLYFIN_PUBLIC and JELLYFIN_SERVER_ID are optional (filled in from JELLYFIN_URL).
# Put it behind HTTPS (a reverse proxy, Tailscale, or Cloudflare Tunnel) if you reach it from outside your home network.

# Environment for server.py (set these in your launchd plist / systemd unit / shell). None are credentials.
JELLYFIN_URL=http://192.168.1.10:8096          # Jellyfin on your LAN (required)
JELLYFIN_PUBLIC=https://jellyfin.example.com   # the same server behind your tunnel (required)
JELLYFIN_SERVER_ID=                            # Id from JELLYFIN_URL/System/Info/Public (required)
CF_TEAM_DOMAIN=your-team.cloudflareaccess.com  # Cloudflare Access team domain (required unless MYFLIX_DEV=1)
CF_ACCESS_AUD=                                 # Access application AUD tag for the MyFlix host
MYFLIX_PORT=8108
MYFLIX_HOST=127.0.0.1                          # 0.0.0.0 to accept connections from other devices (setup.sh and Docker do this)
# Per-device pairing (optional): a registry service that maps device client ids to people.
MYFLIX_REGISTRY_URL=
MYFLIX_REGISTRY_KEYCHAIN_SERVICE=myflix-registry-token
MYFLIX_REGISTRY_KEYCHAIN_ACCOUNT=myflix
# Single shared-token TV (optional, legacy): comma list of Access service-token client ids and the account they act as.
MYFLIX_TV_CLIENT_IDS=
MYFLIX_TV_EMAIL=
# Remote device limits
MYFLIX_REMOTE_MAX_BITRATE=15000000
MYFLIX_REMOTE_MAX_STREAMS=3
MYFLIX_HOME_IPS=
# Jellyseerr requests (optional; see README "Requests"). The API key comes from MYFLIX_SEERR_KEY or the macOS Keychain item below.
MYFLIX_SEERR_URL=                              # e.g. http://192.168.1.10:5055
# MYFLIX_SEERR_KEY=                            # Jellyseerr > Settings > General > API Key (keep this file private)
MYFLIX_SEERR_KEYCHAIN_SERVICE=myflix-jellyseerr-api
MYFLIX_QB_URL=                                 # qBittorrent Web UI, for a real "downloading" status (needs its LAN auth bypass)
# Who counts as an owner (may change the theme for everyone etc.) in Cloudflare mode; password mode has one owner.
# MYFLIX_OWNER_EMAILS=a@example.com,b@example.com
# MYFLIX_HIDDEN_NAMES=                         # Jellyfin user names never offered as profiles (comma list)
# MYFLIX_JF_ADMIN_KEY=                         # Jellyfin admin API key: lists accounts not linked to MyFlix yet (optional)
# MYFLIX_REGISTRY_TOKEN_FILE=                  # Linux: 0600 file holding the registry token instead of the Keychain
# MYFLIX_LAN_BASE=                             # http://<lan address>:8108, handed to paired TVs so they work with the internet down
# MYFLIX_PHONE_BASE=                           # public https address shown in the "link on your phone" QR code
# MYFLIX_ROUTER=192.168.1.1                    # /netmon: your router's address
# MYFLIX_NETMON_URL=                           # /netmon: your public MyFlix health URL, e.g. https://myflix.example.com/healthz
# TV hand-off / cast / remote (optional): Jellyfin device name -> label, and -> LAN IP with ADB on :5555 (lets the phone/Echo stop, pause, cast to the TV).
MYFLIX_TV_NAMES=
MYFLIX_TV_ADB=
MYFLIX_CAST=0                                  # 1 = Echo Hub / phone "cast to TV" (TV app 2.4.0+ reads the cast_item launch extra)
MYFLIX_ADB=/opt/homebrew/bin/adb
MYFLIX_CAST_PKG=dev.theprivatehome.myflix      # the TV app's package id (change it if you renamed the package)
# Echo Hub extras (optional; see README "Home extras"): voice search + wake word + doorbell popup.
MYFLIX_STT_URL=http://127.0.0.1:8119           # local faster-whisper service (POST audio, returns {"text"})
MYFLIX_HA_URL=                                 # Home Assistant base URL, only used by /hook/doorbell-live
MYFLIX_DOORBELL_CAMERA=                        # HA camera entity for the doorbell, e.g. camera.front_door
