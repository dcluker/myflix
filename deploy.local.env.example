# Copy to deploy.local.env (gitignored). None of these are secrets; the Cloudflare API token is read from the Keychain.
HOST=myflix.example.com
PORT=8108
ACCT=<cloudflare account id>
ZONE=<cloudflare zone id>
TUNNEL=<cloudflared tunnel id>
GOOGLE_IDP=<Access identity provider id>
ACCESS_GROUP=<Access group id allowed to sign in>
CF_TEAM_DOMAIN=<team>.cloudflareaccess.com
CF_TOKEN_KEYCHAIN=<keychain item holding a Cloudflare API token>
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_PUBLIC=https://jellyfin.example.com
JELLYFIN_SERVER_ID=<Id from JELLYFIN_URL/System/Info/Public>
# Optional
TV_CLIENT_IDS=
TV_EMAIL=
REGISTRY_URL=
REGISTRY_KEYCHAIN_SERVICE=myflix-registry-token
SEERR_URL=
SEERR_KEYCHAIN_SERVICE=myflix-jellyseerr-api
# TV hand-off (optional): Jellyfin device name -> label, and -> LAN IP with ADB on :5555 (lets the phone stop the TV)
HANDOFF_TV_NAMES=
HANDOFF_TV_ADB=
# Runtime settings written into the launchd plist when set (omit to use server defaults)
# PYTHON_BIN=/opt/homebrew/bin/python3.14
# TUNNEL_CFG=~/.cloudflared/mac-files.yml
# TUNNEL_SERVICE=com.mac.files-tunnel
# DNS_NAME=myflix
# MYFLIX_OWNER_EMAILS=a@example.com,b@example.com
# MYFLIX_PHONE_BASE=https://myflix.example.com
# MYFLIX_CAST=
# MYFLIX_JF_AUTOLOGIN=
# MYFLIX_STT_URL=
# MYFLIX_HA_URL=
# MYFLIX_DOORBELL_CAMERA=
# CF_ACCESS_AUD_JELLYFIN=
