<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:banner="@drawable/tile_banner"
        android:icon="@mipmap/ic_tile"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MyFlix">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tile_banner"
            android:icon="@mipmap/ic_tile"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape" />

        <!-- The launcher entry lives on an alias: the Fire TV launcher caches tile art per launch
             component (even across uninstalls), so a new component name forces fresh art. -->
        <activity-alias
            android:name=".Home"
            android:targetActivity=".MainActivity"
            android:banner="@drawable/tile_banner"
            android:icon="@mipmap/ic_tile"
            android:label="@string/app_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".PairActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:windowSoftInputMode="stateHidden"
            android:screenOrientation="sensorLandscape" />

        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
    </application>
</manifest>
